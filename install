#!/usr/bin/env bash
set -euo pipefail
APP=grexcode

MUTED='\033[0;2m'
RED='\033[0;31m'
ORANGE='\033[38;5;214m'
NC='\033[0m'

usage() {
    cat <<EOF
GrexCode Installer

Usage: install.sh [options]

Options:
    -h, --help              Display this help message
    -v, --version <version> Install a specific version (e.g., 1.17.9)
    -b, --binary <path>     Install from a local binary instead of downloading
        --no-modify-path    Don't modify shell config files

Examples:
    curl -fsSL https://grexlabs.in/install | bash
    curl -fsSL https://grexlabs.in/install | bash -s -- --version 1.17.9
    ./install --binary /path/to/grexcode
EOF
}

requested_version=${VERSION:-}
no_modify_path=false
binary_path=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help) usage; exit 0 ;;
        -v|--version)
            if [[ -n "${2:-}" ]]; then
                requested_version="$2"; shift 2
            else
                echo -e "${RED}Error: --version requires a version argument${NC}"
                exit 1
            fi ;;
        -b|--binary)
            if [[ -n "${2:-}" ]]; then
                binary_path="$2"; shift 2
            else
                echo -e "${RED}Error: --binary requires a path argument${NC}"
                exit 1
            fi ;;
        --no-modify-path) no_modify_path=true; shift ;;
        *) echo -e "${ORANGE}Warning: Unknown option '$1'${NC}" >&2; shift ;;
    esac
done

INSTALL_DIR=$HOME/.grexcode/bin
mkdir -p "$INSTALL_DIR"

if [ -n "$binary_path" ]; then
    if [ ! -f "$binary_path" ]; then
        echo -e "${RED}Error: Binary not found at ${binary_path}${NC}"
        exit 1
    fi
    specific_version="local"
else
    raw_os=$(uname -s)
    os=$(echo "$raw_os" | tr '[:upper:]' '[:lower:]')
    case "$raw_os" in
      Darwin*) os="darwin" ;;
      Linux*) os="linux" ;;
      MINGW*|MSYS*|CYGWIN*) os="windows" ;;
    esac

    arch=$(uname -m)
    [[ "$arch" == "aarch64" ]] && arch="arm64"
    [[ "$arch" == "x86_64" ]] && arch="x64"

    if [ "$os" = "darwin" ] && [ "$arch" = "x64" ]; then
      rosetta_flag=$(sysctl -n sysctl.proc_translated 2>/dev/null || echo 0)
      [ "$rosetta_flag" = "1" ] && arch="arm64"
    fi

    combo="$os-$arch"
    case "$combo" in
      linux-x64|linux-arm64|darwin-x64|darwin-arm64|windows-x64) ;;
      *)
        echo -e "${RED}Unsupported OS/Arch: $os/$arch${NC}"
        exit 1
        ;;
    esac

    archive_ext=".zip"
    [ "$os" = "linux" ] && archive_ext=".tar.gz"

    is_musl=false
    if [ "$os" = "linux" ]; then
      [ -f /etc/alpine-release ] && is_musl=true
      if command -v ldd >/dev/null 2>&1; then
        ldd --version 2>&1 | grep -qi musl && is_musl=true
      fi
    fi

    needs_baseline=false
    if [ "$arch" = "x64" ]; then
      if [ "$os" = "linux" ]; then
        grep -qwi avx2 /proc/cpuinfo 2>/dev/null || needs_baseline=true
      fi
      if [ "$os" = "darwin" ]; then
        avx2=$(sysctl -n hw.optional.avx2_0 2>/dev/null || echo 0)
        [ "$avx2" != "1" ] && needs_baseline=true
      fi
    fi

    target="$os-$arch"
    [ "$needs_baseline" = "true" ] && target="$target-baseline"
    [ "$is_musl" = "true" ] && target="$target-musl"

    filename="$APP-$target$archive_ext"

    if [ "$os" = "linux" ]; then
        command -v tar >/dev/null 2>&1 || { echo -e "${RED}Error: 'tar' required${NC}"; exit 1; }
    else
        command -v unzip >/dev/null 2>&1 || { echo -e "${RED}Error: 'unzip' required${NC}"; exit 1; }
    fi

    if [ -z "$requested_version" ]; then
        url="https://github.com/grexlabs/grexcode/releases/latest/download/$filename"
        specific_version=$(curl -s https://api.github.com/repos/grexlabs/grexcode/releases/latest | sed -n 's/.*"tag_name": *"v\([^"]*\)".*/\1/p')
        if [[ $? -ne 0 || -z "$specific_version" ]]; then
            echo -e "${RED}Failed to fetch version info${NC}"
            exit 1
        fi
    else
        requested_version="${requested_version#v}"
        url="https://github.com/grexlabs/grexcode/releases/download/v${requested_version}/$filename"
        specific_version=$requested_version
        http_status=$(curl -sI -o /dev/null -w "%{http_code}" "https://github.com/grexlabs/grexcode/releases/tag/v${requested_version}")
        if [ "$http_status" = "404" ]; then
            echo -e "${RED}Error: Release v${requested_version} not found${NC}"
            echo -e "${MUTED}See releases: https://github.com/grexlabs/grexcode/releases${NC}"
            exit 1
        fi
    fi
fi

check_version() {
    if command -v grexcode >/dev/null 2>&1; then
        installed_version=$(grexcode --version 2>/dev/null || echo "")
        if [[ "$installed_version" != "$specific_version" ]]; then
            echo -e "${MUTED}Installed: ${NC}$installed_version"
        else
            echo -e "${MUTED}Version ${NC}$specific_version${MUTED} already installed${NC}"
            exit 0
        fi
    fi
}

download_and_install() {
    echo -e "\n${MUTED}Installing ${NC}$APP ${MUTED}version: ${NC}$specific_version"
    local tmp_dir="${TMPDIR:-/tmp}/${APP}_install_$$"
    mkdir -p "$tmp_dir"
    if [ "$os" = "linux" ]; then
        curl -# -L -o "$tmp_dir/$filename" "$url"
        tar -xzf "$tmp_dir/$filename" -C "$tmp_dir"
    else
        curl -# -L -o "$tmp_dir/$filename" "$url"
        unzip -q "$tmp_dir/$filename" -d "$tmp_dir"
    fi
    mv "$tmp_dir/$APP" "$INSTALL_DIR"
    chmod 755 "${INSTALL_DIR}/${APP}"
    rm -rf "$tmp_dir"
}

install_from_binary() {
    echo -e "\n${MUTED}Installing ${NC}$APP ${MUTED}from: ${NC}$binary_path"
    cp "$binary_path" "${INSTALL_DIR}/${APP}"
    chmod 755 "${INSTALL_DIR}/${APP}"
}

if [ -n "$binary_path" ]; then
    install_from_binary
else
    check_version
    download_and_install
fi

add_to_path() {
    local config_file=$1
    local command=$2
    if grep -Fxq "$command" "$config_file"; then
        echo -e "${MUTED}Already in $config_file${NC}"
    elif [[ -w $config_file ]]; then
        echo -e "\n# grexcode" >> "$config_file"
        echo "$command" >> "$config_file"
        echo -e "${MUTED}Added ${NC}$APP ${MUTED}to PATH in ${NC}$config_file"
    fi
}

XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-$HOME/.config}
current_shell=$(basename "$SHELL")
case $current_shell in
    fish) config_files="$HOME/.config/fish/config.fish" ;;
    zsh) config_files="${ZDOTDIR:-$HOME}/.zshrc ${ZDOTDIR:-$HOME}/.zshenv $XDG_CONFIG_HOME/zsh/.zshrc $XDG_CONFIG_HOME/zsh/.zshenv" ;;
    bash) config_files="$HOME/.bashrc $HOME/.bash_profile $HOME/.profile $XDG_CONFIG_HOME/bash/.bashrc $XDG_CONFIG_HOME/bash/.bash_profile" ;;
    ash|sh) config_files="$HOME/.profile" ;;
    *) config_files="$HOME/.bashrc $HOME/.bash_profile" ;;
esac

if [[ "$no_modify_path" != "true" ]]; then
    config_file=""
    for file in $config_files; do
        if [[ -f $file ]]; then
            config_file=$file
            break
        fi
    done

    if [[ -z $config_file ]]; then
        echo -e "${ORANGE}No config file found. Manually add:${NC}"
        echo -e "  export PATH=\$HOME/.grexcode/bin:\$PATH"
    elif [[ ":$PATH:" != *":$INSTALL_DIR:"* ]]; then
        case $current_shell in
            fish) add_to_path "$config_file" "fish_add_path $INSTALL_DIR" ;;
            zsh|bash|ash|sh) add_to_path "$config_file" "export PATH=\$HOME/.grexcode/bin:\$PATH" ;;
        esac
    fi
fi

if [ -n "${GITHUB_ACTIONS-}" ] && [ "${GITHUB_ACTIONS}" == "true" ]; then
    echo "$INSTALL_DIR" >> $GITHUB_PATH
fi

echo -e ""
echo -e "${ORANGE}  ██████╗ ██████╗ ███████╗██╗  ██╗${NC}"
echo -e "${ORANGE}  ██╔══██╗██╔══██╗██╔════╝╚██╗██╔╝${NC}"
echo -e "${ORANGE}  ██║  ██║██████╔╝█████╗   ╚███╔╝ ${NC}"
echo -e "${ORANGE}  ██║  ██║██╔══██╗██╔══╝   ██╔██╗ ${NC}"
echo -e "${ORANGE}  ██████╔╝██║  ██║███████╗██╔╝ ██╗${NC}"
echo -e "${ORANGE}  ╚═════╝ ╚═╝  ╚═╝╚══════╝╚═╝  ╚═╝${NC}"
echo -e ""
echo -e "${MUTED}  GrexCode includes free models, to start:${NC}"
echo -e ""
echo -e "  cd <project>"
echo -e "  grexcode"
echo -e ""
echo -e "${MUTED}  For more info visit ${NC}https://grexlabs.in/docs"
echo -e ""
